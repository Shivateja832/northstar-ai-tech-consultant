# Copy this file to .env. Never commit real keys or credentials.

# Local Ollama model. Ollama ignores this placeholder key and serves the OpenAI-compatible API
# on this URL. Change OPENAI_BASE_URL and OPENAI_API_KEY only when choosing a hosted provider.
OPENAI_API_KEY=ollama
OPENAI_BASE_URL=http://127.0.0.1:11434/v1
OPENAI_MODEL=llama3.2:3b
AI_REQUEST_TIMEOUT_SECONDS=180
AI_MAX_OUTPUT_TOKENS=512
LOCAL_AI_FAST_MODE=true
# Audio transcription is a separate provider API and requires a valid transcription API key.
TRANSCRIPTION_API_KEY=
TRANSCRIPTION_BASE_URL=https://api.openai.com/v1
TRANSCRIPTION_MODEL=whisper-1
# Optional shared bearer token. When configured, it protects all non-health API routes,
# is required by the workspace, and also gates the model-generation endpoint.
SERVICE_API_TOKEN=

# Optional screenshot understanding. This sends public help-center image URLs and article context
# to the configured vision-capable model. Keep false until you have reviewed provider/data terms.
VISION_ANALYSIS_ENABLED=false

# Knowledge refresh: starts shortly after the Knowledge Brain starts, then repeats every 24 hours.
AUTO_REFRESH=true
CRAWL_DELAY_SECONDS=0.75
# 0 means crawl all sitemap pages. Set a positive value only for a limited test run.
CRAWL_MAX_PAGES=0
HELP_CENTER_SITEMAP_URL=https://support.brilliantdirectories.com/support/sitemap.xml

# Inbox auto-send is disabled unless explicitly enabled. Test and review eligibility before changing.
AUTO_SEND_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Optional live inbox integration (use an app-specific password or provider OAuth integration).
IMAP_HOST=
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=
IMAP_PASSWORD=
IMAP_MAILBOX=INBOX

# Set explicit production frontend origin(s), comma-separated. Local default is localhost:8080.
CORS_ORIGINS=http://localhost:8080

# Optional quote rate used in deterministic estimation.
DEFAULT_HOURLY_RATE=95
